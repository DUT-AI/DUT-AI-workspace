{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthLoginResponse",
  "description": "Response envelope returned by POST /api/v1/auth/login",
  "type": "object",
  "required": ["is_success", "status_code", "message"],
  "properties": {
    "is_success": {
      "type": "boolean"
    },
    "status_code": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": ["object", "null"],
      "properties": {
        "access_token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        }
      },
      "required": ["access_token", "refresh_token", "token_type"]
    },
    "pagination": {
      "type": ["object", "null"]
    }
  }
}
